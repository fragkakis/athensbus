<% content_for :title, "Ημερήσιος Προγραμματισμός vs Κανονικό Πρόγραμμα - #{APP_NAME_NO_DOMAIN}" %>
<% content_for :description, "Σύγκριση ημερήσιου προγραμματισμού με το κανονικό πρόγραμμα λεωφορείων #{CITY_NAME}ς. Δείτε πόσα δρομολόγια προγραμματίζονται καθημερινά σε σχέση με το κανονικό πρόγραμμα." %>

<div class="container mt-4">
  <h1 class="mb-4">
    <i class="bi bi-calendar-check"></i> Ημερήσιος Προγραμματισμός vs Κανονικό πρόγραμμα
  </h1>

  <!-- Collapsible Info Section -->
  <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px;">
    <div class="card-body p-0">
      <div class="accordion accordion-flush" id="infoAccordion">
        <div class="accordion-item border-0" style="border-radius: 8px; overflow: hidden; border: 1px solid #e9ecef !important;">
          <h2 class="accordion-header">
            <button class="accordion-button collapsed fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseInfo" aria-expanded="false" aria-controls="collapseInfo" style="background-color: #f8f9fa;">
              <i class="bi bi-chevron-right me-2 accordion-icon"></i>
              Τι φαίνεται σε αυτή τη σελίδα;
            </button>
          </h2>
          <div id="collapseInfo" class="accordion-collapse collapse" data-bs-parent="#infoAccordion">
            <div class="accordion-body bg-white p-4">
              <p class="mb-0">
                Σε αυτή τη σελίδα φαίνεται η σύγκριση μεταξύ του ημερήσιου προγραμματισμού και του κανονικού προγράμματος. Το ποσοστό δείχνει πόσα δρομολόγια από το κανονικό πρόγραμμα περιλαμβάνονται στον ημερήσιο προγραμματισμό.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <style>
    .accordion-button:not(.collapsed) .accordion-icon {
      transform: rotate(90deg);
      transition: transform 0.2s ease-in-out;
    }
    .accordion-icon {
      transition: transform 0.2s ease-in-out;
    }
    .accordion-button:not(.collapsed) {
      background-color: #e7f1ff !important;
      color: #0d6efd;
    }
    .accordion-button:focus {
      box-shadow: none;
      border-color: rgba(0,0,0,.125);
    }
  </style>

  <!-- Date Picker Card -->
  <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px;">
    <div class="card-body p-4">
      <%= form_with(url: daily_vs_normal_reports_path, method: :get) do |f| %>
        <div class="row g-3">
          <div class="col-12 col-md-6">
            <label for="date" class="form-label fw-semibold">
              <i class="bi bi-calendar-event me-1"></i>Ημερομηνία
            </label>
            <input type="date" id="date" name="date"
                   class="form-control form-control-lg"
                   min="<%= @date_min %>"
                   max="<%= @date_max %>"
                   value="<%= params[:date] || @date_max %>" />
            <div class="form-text">
              <i class="bi bi-info-circle me-1"></i>Διάλεξε την ημερομηνία
            </div>
          </div>
        </div>
        <input type="hidden" name="sort" value="<%= @sort_column %>" />
        <input type="hidden" name="direction" value="<%= @sort_direction %>" />
      <% end %>
    </div>
  </div>

  <div class="card shadow-sm">
    <div class="card-body">
      <table class="table table-striped table-hover">
        <thead class="table-dark">
          <tr>
            <th class="align-middle">
              <div class="d-inline-flex align-items-center">
                <%= link_to daily_vs_normal_reports_path(sort: 'line_id', direction: @sort_column == 'line_id' && @sort_direction == 'asc' ? 'desc' : 'asc', date: params[:date]), class: 'text-white text-decoration-none' do %>
                  Γραμμή
                  <% if @sort_column == 'line_id' %>
                    <i class="bi bi-caret-<%= @sort_direction == 'asc' ? 'up' : 'down' %>-fill"></i>
                  <% end %>
                <% end %>
                <span data-bs-toggle="tooltip" data-bs-placement="top" data-bs-html="true" data-bs-title="Ο αριθμός και το όνομα της γραμμής" class="ms-1" style="cursor: pointer;">
                  <i class="bi bi-question-circle-fill text-white-50" style="font-size: 0.9rem;"></i>
                </span>
              </div>
            </th>
            <th class="align-middle">
              <div class="d-inline-flex align-items-center">
                Κατεύθυνση
                <span data-bs-toggle="tooltip" data-bs-placement="top" data-bs-html="true" data-bs-title="Η κατεύθυνση της διαδρομής (πατήστε για λεπτομέρειες)" class="ms-1" style="cursor: pointer;">
                  <i class="bi bi-question-circle-fill text-white-50" style="font-size: 0.9rem;"></i>
                </span>
              </div>
            </th>
            <th class="align-middle">
              <div class="d-inline-flex align-items-center">
                <%= link_to daily_vs_normal_reports_path(sort: 'normal_schedule_count', direction: @sort_column == 'normal_schedule_count' && @sort_direction == 'desc' ? 'asc' : 'desc', date: params[:date]), class: 'text-white text-decoration-none' do %>
                  Κανονικό πρόγραμμα
                  <% if @sort_column == 'normal_schedule_count' %>
                    <i class="bi bi-caret-<%= @sort_direction == 'asc' ? 'up' : 'down' %>-fill"></i>
                  <% end %>
                <% end %>
                <span data-bs-toggle="tooltip" data-bs-placement="top" data-bs-html="true" data-bs-title="Το κανονικό πρόγραμμα για τα δρομολόγια. Αν δεν υπάρχει καμμία έλλειψη σε οχήματα και προσωπικό, αυτά τα δρομολόγια θα πρέπει να γίνουν." class="ms-1" style="cursor: pointer;">
                  <i class="bi bi-question-circle-fill text-white-50" style="font-size: 0.9rem;"></i>
                </span>
              </div>
            </th>
            <th class="align-middle">
              <div class="d-inline-flex align-items-center">
                <%= link_to daily_vs_normal_reports_path(sort: 'daily_schedule_count', direction: @sort_column == 'daily_schedule_count' && @sort_direction == 'desc' ? 'asc' : 'desc', date: params[:date]), class: 'text-white text-decoration-none' do %>
                  Ημερήσιος προγραμματισμός
                  <% if @sort_column == 'daily_schedule_count' %>
                    <i class="bi bi-caret-<%= @sort_direction == 'asc' ? 'up' : 'down' %>-fill"></i>
                  <% end %>
                <% end %>
                <span data-bs-toggle="tooltip" data-bs-placement="top" data-bs-html="true" data-bs-title="Το αναθεωρημένο πρόγραμμα που καταρτίζεται τις προηγούμενες μέρες, λαμβάνοντας υπόψιν τις ελλείψεις σε οχήματα και προσωπικό." class="ms-1" style="cursor: pointer;">
                  <i class="bi bi-question-circle-fill text-white-50" style="font-size: 0.9rem;"></i>
                </span>
              </div>
            </th>
            <th class="align-middle">
              <div class="d-inline-flex align-items-center">
                <%= link_to daily_vs_normal_reports_path(sort: 'percentage', direction: @sort_column == 'percentage' && @sort_direction == 'desc' ? 'asc' : 'desc', date: params[:date]), class: 'text-white text-decoration-none' do %>
                  Ποσοστό
                  <% if @sort_column == 'percentage' %>
                    <i class="bi bi-caret-<%= @sort_direction == 'asc' ? 'up' : 'down' %>-fill"></i>
                  <% end %>
                <% end %>
                <span data-bs-toggle="tooltip" data-bs-placement="top" data-bs-html="true" data-bs-title="Το ποσοστό του ημερήσιου προγραμματισμού σε σχέση με το κανονικό πρόγραμμα<br><br>🟢 Πράσινο: 100%<br>🟡 Κίτρινο: 90%<br>🟠 Πορτοκαλί: 80%<br>🔴 Κόκκινο: ≤70%<br><br>Τα χρώματα μεταβάλλονται σταδιακά" class="ms-1" style="cursor: pointer;">
                  <i class="bi bi-question-circle-fill text-white-50" style="font-size: 0.9rem;"></i>
                </span>
              </div>
            </th>
          </tr>
        </thead>
        <tbody>
          <% @results.each do |result| %>
            <tr>
              <td>
                <%= result["line_id"] %> - <%= result["line_description"] %>
              </td>
              <td>
                <%= link_to lines_path(line_code: result["line_code"], route_id: result["route_id"], date: params[:date]), class: 'text-decoration-none' do %>
                  <%= result["route_description"] %>
                <% end %>
              </td>
              <td><%= result["normal_schedule_count"] %></td>
              <td><%= result["daily_schedule_count"] %></td>
              <td>
                <% if result["percentage"].present? %>
                  <% percentage = result["percentage"].to_f.round %>
                  <%
                    # Color gradient logic:
                    # 100% = green (rgb(40, 167, 69))
                    # 90% = yellow (rgb(255, 193, 7))
                    # 80% = orange (rgb(253, 126, 20))
                    # 70% = red (rgb(220, 53, 69))
                    # < 70% = red

                    if percentage >= 100
                      bg_color = 'rgb(40, 167, 69)'
                      text_color = 'white'
                    elsif percentage >= 90
                      # Gradient between green and yellow
                      ratio = (percentage - 90) / 10.0
                      r = 40 + (255 - 40) * (1 - ratio)
                      g = 167 + (193 - 167) * (1 - ratio)
                      b = 69 + (7 - 69) * (1 - ratio)
                      bg_color = "rgb(#{r.round}, #{g.round}, #{b.round})"
                      text_color = percentage >= 95 ? 'white' : 'black'
                    elsif percentage >= 80
                      # Gradient between yellow and orange
                      ratio = (percentage - 80) / 10.0
                      r = 253 + (255 - 253) * ratio
                      g = 126 + (193 - 126) * ratio
                      b = 20 + (7 - 20) * ratio
                      bg_color = "rgb(#{r.round}, #{g.round}, #{b.round})"
                      text_color = 'black'
                    elsif percentage >= 70
                      # Gradient between orange and red
                      ratio = (percentage - 70) / 10.0
                      r = 220 + (253 - 220) * ratio
                      g = 53 + (126 - 53) * ratio
                      b = 69 + (20 - 69) * ratio
                      bg_color = "rgb(#{r.round}, #{g.round}, #{b.round})"
                      text_color = 'white'
                    else
                      # Red for < 70%
                      bg_color = 'rgb(220, 53, 69)'
                      text_color = 'white'
                    end
                  %>
                  <span class="badge" style="background-color: <%= bg_color %>; color: <%= text_color %>;"><%= percentage %>%</span>
                <% else %>
                  <span class="badge bg-secondary">N/A</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script type="module">
  $(document).ready(function() {
    // Submit form when date changes
    $('#date').on('change', function() {
      $(this).closest('form').submit();
    });
  });
</script>
