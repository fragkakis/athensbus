<% if(@line.present?) %>

  <h2>Δρομολόγια</h2>
  <div class="wrapper">

    <div class="p-3">
      <h4>Προβλεπόμενα</h4>
      <div class="alert alert-secondary" role="alert">
        Προβλέπονται <%= @normal_schedule.size %> δρομολόγια
      </div>
      <% (@normal_schedule.group_by { |t| t.split(":").first }).each do |hour_group, hours| %>
        <h5 class="d-inline"><span class="badge rounded-pill text-bg-secondary"><%= hour_group %></span></h5>
        <% hours.each do |hour| %>
          <span class="badge text-bg-light"><%= hour %></span>
        <% end %>
        <br/>
      <% end %>
    </div>

    <div class="p-3">
      <h4>Ημερήσιος προγραμματισμός</h4>
      <% if @normal_schedule.size > @daily_schedule.size %>
        <div class="alert alert-danger" role="alert">
          Προγραμματίστηκαν <%= @daily_schedule.size %> δρομολόγια (-<%= @normal_schedule.size - @daily_schedule.size %>)
        </div>
      <% else %>
        <div class="alert alert-success" role="alert">
          Προγραμματίστηκαν <%= @daily_schedule.size %> δρομολόγια
        </div>
      <% end %>
      <% (@daily_schedule.group_by { |t| t.split(":").first }).each do |hour_group, hours| %>
        <h5 class="d-inline"><span class="badge rounded-pill text-bg-secondary"><%= hour_group %></span></h5>
        <% hours.each do |hour| %>
          <span class="badge text-bg-light"><%= hour %></span>
        <% end %>
        <br/>
      <% end %>
    </div>

    <div class="p-3">
      <% normal_trips = @trips.select{|trip| trip.size > 5} %>
      <h4>Εκτελεσμένα</h4>
      <% if @normal_schedule.size > normal_trips.size %>
        <div class="alert alert-danger" role="alert">
          <span>Εκτελέστηκαν <%= normal_trips.size %> δρομολόγια (<%= normal_trips.size - @normal_schedule.size %>)</span>
          <% if @date.today? %>
            <div class="spinner-border" role="status">
              <span class="visually-hidden">Loading...</span>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="alert alert-success" role="alert">
          <span>Εκτελέστηκαν <%= normal_trips.size %> δρομολόγια</span>
          <% if @date.today? %>
            <div class="spinner-border" role="status">
              <span class="visually-hidden">Loading...</span>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

  </div>
<% end %>