<% if(@line.present?) %>

  <h2>Πρόγραμμα</h2>
  <div class="wrapper">
    <div class="p-3">
      <h3>Προβλεπόμενα</h3>
      <div class="alert alert-secondary" role="alert">
        Προβλέπονται <%= @normal_schedule.size %> δρομολόγια
      </div>
      <% (@normal_schedule.group_by { |t| t.split(":").first }).each do |hour_group, hours| %>
        <h5 class="d-inline"><span class="badge rounded-pill text-bg-secondary"><%= hour_group %></span></h5>
        <% hours.each do |hour| %>
          <span class="badge text-bg-light"><%= hour %></span>
        <% end %>
        <br/>
      <% end %>
    </div>

    <div class="p-3">
      <h3>Προγραμματισμένα</h3>
      <% if @normal_schedule.size > @daily_schedule.size %>
        <div class="alert alert-danger" role="alert">
          Προγραμματίστηκαν <%= @daily_schedule.size %> δρομολόγια (-<%= @normal_schedule.size - @daily_schedule.size %>)
        </div>
      <% else %>
        <div class="alert alert-success" role="alert">
          Προγραμματίστηκαν <%= @daily_schedule.size %> δρομολόγια
        </div>
      <% end %>
      <% (@daily_schedule.group_by { |t| t.split(":").first }).each do |hour_group, hours| %>
        <h5 class="d-inline"><span class="badge rounded-pill text-bg-secondary"><%= hour_group %></span></h5>
        <% hours.each do |hour| %>
          <span class="badge text-bg-light"><%= hour %></span>
        <% end %>
        <br/>
      <% end %>
    </div>

    <div class="p-3">
      <% normal_trips = @trips.select{|trip| trip.size > 5} %>
      <h3>Εκτελεσμένα</h3>
      <div class="alert alert-danger" role="alert">
        Εκτελέστηκαν <%= normal_trips.size %> δρομολόγια (-<%= @normal_schedule.size - normal_trips.size %>)
      </div>
    </div>

  </div>
<% end %>