<div class="py-4">

  <!-- Line Header -->
  <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
    <div class="card-body p-3 p-md-4 text-white">
      <h2 class="mb-0 fw-bold fs-4 fs-md-3">
        <%= image_tag 'icon.png', alt: 'Bus', style: 'height: 1.6em; vertical-align: middle; filter: brightness(0) invert(1);' %>
        <% if(@route.line.line_id == "140") %>
          <%= link_to "140", "https://www.youtube.com/watch?v=s4UwlLzHn5A", class: "text-white text-decoration-none" %>: <%= @route.description %>
        <% else %>
          <%= "#{@route.line.line_id}: #{@route.description}" %>
        <% end %>
      </h2>
    </div>
  </div>

  <!-- Statistics Chart -->
  <div class="card border-0 shadow-sm" style="border-radius: 12px; border-left: 4px solid #ff9800 !important;">
    <div class="card-body p-4">
      <h3 class="card-title mb-3 fw-bold text-secondary">
        <i class="bi bi-bar-chart-line me-2"></i>Ιστορικό Δρομολογίων
      </h3>

      <div class="alert alert-warning border-0 mb-4" style="background-color: #fff3cd;">
        <div class="d-flex align-items-start">
          <i class="bi bi-exclamation-triangle-fill me-2 mt-1"></i>
          <div>
            <strong>Σημείωση:</strong> Τα "Εκτελεσμένα" δρομολόγια είναι <strong>κατά προσέγγιση</strong>, καθώς βασίζονται σε ελλιπή δεδομένα τηλεματικής. Οι αριθμοί μπορεί να διαφέρουν σημαντικά από την πραγματικότητα.
          </div>
        </div>
      </div>

      <div class="chart-container">
        <%= line_chart [
          {name: "Προβλεπόμενα", data: @route.schedules.normal.where.not(date: Date.current).order(:date).map{|s| [s.date, s.departure_times.size]}},
          {name: "Ημερήσιος προγραμματισμός", data: @route.schedules.daily.where.not(date: Date.current).order(:date).map{|s| [s.date, s.departure_times.size]}},
          {name: "Εκτελεσμένα (κατά προσέγγιση)", data: @route.route_daily_reports.where.not(date: Date.current).order(:date).map{|rdr| [rdr.date, rdr.executed_trips]}}
        ],
        colors: ["#28a745", "#dc3545", "#ffc107"],
        library: {
          backgroundColor: '#ffffff',
          borderRadius: 8
        }
        %>
      </div>
    </div>
  </div>

</div>