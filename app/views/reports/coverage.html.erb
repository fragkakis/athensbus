<% content_for :title, "Coverage Report" %>

<div class="container mt-4">
  <h1 class="mb-4">
    <i class="bi bi-map"></i> Κάλυψη διαδρομών
  </h1>

  <div class="alert alert-info" role="alert">
    <p class="mb-0">
      Κάλυψη ονομάζουμε το ποσοστό πραγματοποίησης δρομολογίων σε σχέση με τα προγραμματισμένα δρομολόγια. Στον παρακάτω πίνακα φαίνονται οι διαδρομές με σειρά φθίνουσας κάλυψης.
    </p>
  </div>

  <div class="card shadow-sm">
    <div class="card-body">
      <table class="table table-striped table-hover">
        <thead class="table-dark">
          <tr>
            <th>
              <%= link_to coverage_reports_path(sort: 'line_id', direction: @sort_column == 'line_id' && @sort_direction == 'asc' ? 'desc' : 'asc', date: params[:date]), class: 'text-white text-decoration-none' do %>
                Γραμμή
                <% if @sort_column == 'line_id' %>
                  <i class="bi bi-caret-<%= @sort_direction == 'asc' ? 'up' : 'down' %>-fill"></i>
                <% end %>
              <% end %>
            </th>
            <th>Κατεύθυνση</th>
            <th>
              <%= link_to coverage_reports_path(sort: 'normal_schedule_count', direction: @sort_column == 'normal_schedule_count' && @sort_direction == 'asc' ? 'desc' : 'asc', date: params[:date]), class: 'text-white text-decoration-none' do %>
                Προβλεπόμενα δρομολόγια
                <% if @sort_column == 'normal_schedule_count' %>
                  <i class="bi bi-caret-<%= @sort_direction == 'asc' ? 'up' : 'down' %>-fill"></i>
                <% end %>
              <% end %>
            </th>
            <th>
              <%= link_to coverage_reports_path(sort: 'daily_schedule_count', direction: @sort_column == 'daily_schedule_count' && @sort_direction == 'asc' ? 'desc' : 'asc', date: params[:date]), class: 'text-white text-decoration-none' do %>
                Ημερήσιος προγραμματισμός
                <% if @sort_column == 'daily_schedule_count' %>
                  <i class="bi bi-caret-<%= @sort_direction == 'asc' ? 'up' : 'down' %>-fill"></i>
                <% end %>
              <% end %>
            </th>
            <th>
              <%= link_to coverage_reports_path(sort: 'executed_trips', direction: @sort_column == 'executed_trips' && @sort_direction == 'asc' ? 'desc' : 'asc', date: params[:date]), class: 'text-white text-decoration-none' do %>
                Εκτελεσμένα δρομολόγια
                <% if @sort_column == 'executed_trips' %>
                  <i class="bi bi-caret-<%= @sort_direction == 'asc' ? 'up' : 'down' %>-fill"></i>
                <% end %>
              <% end %>
            </th>
            <th>
              <%= link_to coverage_reports_path(sort: 'coverage', direction: @sort_column == 'coverage' && @sort_direction == 'asc' ? 'desc' : 'asc', date: params[:date]), class: 'text-white text-decoration-none' do %>
                Κάλυψη
                <% if @sort_column == 'coverage' %>
                  <i class="bi bi-caret-<%= @sort_direction == 'asc' ? 'up' : 'down' %>-fill"></i>
                <% end %>
              <% end %>
            </th>
          </tr>
        </thead>
        <tbody>
          <% @results.each do |result| %>
            <tr>
              <td><%= result["line_id"] %> - <%= result["line_description"] %></td>
              <td><%= result["route_description"] %></td>
              <td><%= result["normal_schedule_count"] %></td>
              <td><%= result["daily_schedule_count"] %></td>
              <td><%= result["executed_trips"] %></td>
              <td>
                <% if result["coverage"].present? %>
                  <% coverage = result["coverage"].to_f.round %>
                  <% badge_class = coverage >= 90 ? 'bg-success' : (coverage >= 80 ? 'bg-warning' : 'bg-danger') %>
                  <span class="badge <%= badge_class %>"><%= coverage %>%</span>
                <% else %>
                  <span class="badge bg-secondary">N/A</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
