<% if(@line.present?) %>

  <!-- Stats Link Card -->
  <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px;">
    <div class="card-body p-4">
      <%= link_to route_stats_url(@route.route_id), class: "btn btn-lg btn-outline-primary w-100" do %>
        <i class="bi bi-bar-chart-line me-2"></i>
        <span class="fw-semibold">Προβολή Στατιστικών</span>
      <% end %>
    </div>
  </div>

  <!-- Schedule Section -->
  <h3 class="mb-4 fw-bold text-secondary">
    <i class="bi bi-clock-history me-2"></i>Δρομολόγια
  </h3>

  <div class="row g-4">

    <!-- Planned Schedule -->
    <div class="col-12 col-lg-4">
      <div class="card h-100 border-0 shadow-sm" style="border-radius: 12px; border-left: 4px solid #198754 !important;">
        <div class="card-body p-4">
          <h5 class="card-title fw-bold mb-3 d-flex align-items-center">
            <i class="bi bi-calendar-check me-2 text-secondary"></i>
            Προβλεπόμενα
            <span data-bs-toggle="tooltip" data-bs-placement="top" data-bs-html="true" data-bs-title="Το κανονικό πρόγραμμα για τα δρομολόγια. Αν δεν υπάρχει καμμία έλλειψη σε οχήματα και προσωπικό, αυτά τα δρομολόγια θα πρέπει να γίνουν." class="ms-2" style="cursor: pointer;">
              <i class="bi bi-info-circle-fill text-muted" style="font-size: 0.9rem;"></i>
            </span>
          </h5>

          <div class="alert alert-secondary border-0 mb-3" style="background-color: #f8f9fa;">
            <div class="d-flex align-items-center">
              <i class="bi bi-check-circle me-2"></i>
              <strong><%= @normal_schedule.size %></strong>
              <span class="ms-1">δρομολόγια</span>
            </div>
          </div>

          <div class="schedule-times">
            <% (@normal_schedule.group_by { |t| t.split(":").first }).each do |hour_group, hours| %>
              <div class="mb-3">
                <h6 class="d-inline me-2">
                  <span class="badge rounded-pill bg-secondary px-3 py-2" style="font-size: 0.9rem;"><%= hour_group %></span>
                </h6>
                <% hours.each do |hour| %>
                  <span class="badge bg-light text-dark me-1 mb-1" style="font-weight: 500;"><%= hour %></span>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <!-- Daily Schedule -->
    <div class="col-12 col-lg-4">
      <div class="card h-100 border-0 shadow-sm" style="border-radius: 12px; border-left: 4px solid #fd7e14 !important;">
        <div class="card-body p-4">
          <h5 class="card-title fw-bold mb-3 d-flex align-items-center">
            <i class="bi bi-calendar-week me-2 <%= @normal_schedule.size > @daily_schedule.size ? 'text-danger' : 'text-success' %>"></i>
            Ημερήσιος προγραμματισμός
            <span data-bs-toggle="tooltip" data-bs-placement="top" data-bs-html="true" data-bs-title="Το αναθεωρημένο πρόγραμμα που καταρτίζεται τις προηγούμενες μέρες, λαμβάνοντας υπόψιν τις ελλείψεις σε οχήματα και προσωπικό. Τυπικά έχει λιγότερα δρομολόγια από τα προβλεπόμενα." class="ms-2" style="cursor: pointer;">
              <i class="bi bi-info-circle-fill text-muted" style="font-size: 0.9rem;"></i>
            </span>
          </h5>

          <div class="alert <%= @normal_schedule.size > @daily_schedule.size ? 'alert-danger' : 'alert-success' %> border-0 mb-3">
            <div class="d-flex align-items-center">
              <i class="bi bi-<%= @normal_schedule.size > @daily_schedule.size ? 'exclamation-triangle' : 'check-circle' %> me-2"></i>
              <strong><%= @daily_schedule.size %></strong>
              <span class="ms-1">δρομολόγια</span>
            </div>
          </div>

          <% if @normal_schedule.size > @daily_schedule.size %>
            <div class="alert alert-warning border-0 mb-3" style="background-color: #fff3cd;">
              <small>
                <i class="bi bi-dash-circle me-1"></i>
                <strong><%= @normal_schedule.size - @daily_schedule.size %></strong> λιγότερα από τα προβλεπόμενα
              </small>
            </div>
          <% end %>

          <div class="schedule-times">
            <% (@daily_schedule.group_by { |t| t.split(":").first }).each do |hour_group, hours| %>
              <div class="mb-3">
                <h6 class="d-inline me-2">
                  <span class="badge rounded-pill bg-secondary px-3 py-2" style="font-size: 0.9rem;"><%= hour_group %></span>
                </h6>
                <% hours.each do |hour| %>
                  <span class="badge bg-light text-dark me-1 mb-1" style="font-weight: 500;"><%= hour %></span>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <!-- Executed Schedule -->
    <div class="col-12 col-lg-4">
      <div class="card h-100 border-0 shadow-sm" style="border-radius: 12px; border-left: 4px solid #dc3545 !important;">
        <div class="card-body p-4">
          <h5 class="card-title fw-bold mb-3 d-flex align-items-center">
            <i class="bi bi-check2-all me-2 <%= @date.today? ? 'text-info' : (@normal_schedule.size > @executed_trips_count ? 'text-danger' : 'text-success') %>"></i>
            Εκτελεσμένα
            <span data-bs-toggle="tooltip" data-bs-placement="top" data-bs-html="true" data-bs-title="Τα πραγματικά δρομολόγια που έγιναν, σύμφωνα με την τηλεματική. Τυπικά είναι ακόμη λιγότερα και από τα δρομολόγια του ημερήσιου προγραμματισμού, λόγω εκτάκτων ελλείψεων σε οχήματα και προσωπικό.<br><br>⚠️ Ο αριθμός είναι κατά προσέγγιση." class="ms-2" style="cursor: pointer;">
              <i class="bi bi-info-circle-fill text-muted" style="font-size: 0.9rem;"></i>
            </span>
          </h5>

          <% if @date.today? %>
            <div class="alert alert-info border-0 mb-3" style="background-color: #cff4fc;">
              <div class="d-flex align-items-center justify-content-between">
                <div>
                  <i class="bi bi-play-circle me-2"></i>
                  <strong><%= @executed_trips_count %></strong>
                  <span class="ms-1">από <%= @normal_schedule.size %></span>
                </div>
                <div class="spinner-border spinner-border-sm" role="status">
                  <span class="visually-hidden">Loading...</span>
                </div>
              </div>
            </div>
          <% elsif @normal_schedule.size > @executed_trips_count %>
            <div class="alert alert-danger border-0 mb-3">
              <div class="d-flex align-items-center">
                <i class="bi bi-exclamation-triangle me-2"></i>
                <strong><%= @executed_trips_count %></strong>
                <span class="ms-1">δρομολόγια</span>
              </div>
            </div>
          <% else %>
            <div class="alert alert-success border-0 mb-3">
              <div class="d-flex align-items-center">
                <i class="bi bi-check-circle me-2"></i>
                <strong><%= @executed_trips_count %></strong>
                <span class="ms-1">δρομολόγια</span>
              </div>
            </div>
          <% end %>

          <% if @executed_trips_count < @normal_schedule.size %>
            <div class="alert alert-warning border-0 mb-3" style="background-color: #fff3cd;">
              <small>
                <i class="bi bi-dash-circle me-1"></i>
                <strong><%= @normal_schedule.size - @executed_trips_count %></strong> λιγότερα από τα προβλεπόμενα
              </small>
            </div>
          <% end %>
        </div>
      </div>
    </div>

  </div>
<% end %>