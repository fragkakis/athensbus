<% content_for :title, "Εκτιμώμενη Κάλυψη Διαδρομών - Athens Bus" %>
<% content_for :description, "Δείτε την εκτιμώμενη κάλυψη των δρομολογίων λεωφορείων της Αθήνας ανά διαδρομή. Ποσοστό πραγματοποίησης δρομολογίων σε σχέση με το προγραμματισμένο πρόγραμμα." %>

<div class="container mt-4">
  <h1 class="mb-4">
    <i class="bi bi-percent"></i> Εκτιμώμενη κάλυψη δρομολογίων
  </h1>

  <!-- Collapsible Info Section -->
  <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px;">
    <div class="card-body p-0">
      <div class="accordion accordion-flush" id="infoAccordion">
        <div class="accordion-item border-0" style="border-radius: 8px; overflow: hidden; border: 1px solid #e9ecef !important;">
          <h2 class="accordion-header">
            <button class="accordion-button collapsed fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseInfo" aria-expanded="false" aria-controls="collapseInfo" style="background-color: #f8f9fa;">
              <i class="bi bi-chevron-right me-2 accordion-icon"></i>
              Τι φαίνεται σε αυτή τη σελίδα;
            </button>
          </h2>
          <div id="collapseInfo" class="accordion-collapse collapse" data-bs-parent="#infoAccordion">
            <div class="accordion-body bg-white p-4">
              <p class="mb-0">
                Κάλυψη ονομάζουμε το ποσοστό πραγματοποίησης δρομολογίων σε σχέση με τα προγραμματισμένα δρομολόγια. Η κάλυψη που υπολογίζουμε για κάθε διαδρομή είναι εκτιμώμενη, καθώς τα δεδομένα της τηλεματικής στα οποία βασιζόμαστε είναι ελλιπή. Στον παρακάτω πίνακα φαίνονται οι διαδρομές με σειρά φθίνουσας εκτιμώμενης κάλυψης.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <style>
    .accordion-button:not(.collapsed) .accordion-icon {
      transform: rotate(90deg);
      transition: transform 0.2s ease-in-out;
    }
    .accordion-icon {
      transition: transform 0.2s ease-in-out;
    }
    .accordion-button:not(.collapsed) {
      background-color: #e7f1ff !important;
      color: #0d6efd;
    }
    .accordion-button:focus {
      box-shadow: none;
      border-color: rgba(0,0,0,.125);
    }
  </style>

  <!-- Date Picker Card -->
  <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px;">
    <div class="card-body p-4">
      <%= form_with(url: estimated_coverage_reports_path, method: :get) do |f| %>
        <div class="row g-3">
          <div class="col-12 col-md-6">
            <label for="date" class="form-label fw-semibold">
              <i class="bi bi-calendar-event me-1"></i>Ημερομηνία
            </label>
            <input type="date" id="date" name="date"
                   class="form-control form-control-lg"
                   min="<%= @date_min %>"
                   max="<%= @date_max %>"
                   value="<%= params[:date] || @date_max %>" />
            <div class="form-text">
              <i class="bi bi-info-circle me-1"></i>Διάλεξε την ημερομηνία
            </div>
          </div>
        </div>
        <input type="hidden" name="sort" value="<%= @sort_column %>" />
        <input type="hidden" name="direction" value="<%= @sort_direction %>" />
      <% end %>
    </div>
  </div>

  <div class="card shadow-sm">
    <div class="card-body">
      <table class="table table-striped table-hover">
        <thead class="table-dark">
          <tr>
            <th class="align-middle">
              <div class="d-inline-flex align-items-center">
                <%= link_to estimated_coverage_reports_path(sort: 'line_id', direction: @sort_column == 'line_id' && @sort_direction == 'asc' ? 'desc' : 'asc', date: params[:date]), class: 'text-white text-decoration-none' do %>
                  Γραμμή
                  <% if @sort_column == 'line_id' %>
                    <i class="bi bi-caret-<%= @sort_direction == 'asc' ? 'up' : 'down' %>-fill"></i>
                  <% end %>
                <% end %>
                <span data-bs-toggle="tooltip" data-bs-placement="top" data-bs-html="true" data-bs-title="Ο αριθμός και το όνομα της γραμμής" class="ms-1" style="cursor: pointer;">
                  <i class="bi bi-question-circle-fill text-white-50" style="font-size: 0.9rem;"></i>
                </span>
              </div>
            </th>
            <th class="align-middle">
              <div class="d-inline-flex align-items-center">
                Κατεύθυνση
                <span data-bs-toggle="tooltip" data-bs-placement="top" data-bs-html="true" data-bs-title="Η κατεύθυνση της διαδρομής (πατήστε για λεπτομέρειες)" class="ms-1" style="cursor: pointer;">
                  <i class="bi bi-question-circle-fill text-white-50" style="font-size: 0.9rem;"></i>
                </span>
              </div>
            </th>
            <th class="align-middle">
              <div class="d-inline-flex align-items-center">
                <%= link_to estimated_coverage_reports_path(sort: 'normal_schedule_count', direction: @sort_column == 'normal_schedule_count' && @sort_direction == 'desc' ? 'asc' : 'desc', date: params[:date]), class: 'text-white text-decoration-none' do %>
                  Προβλεπόμενα δρομολόγια
                  <% if @sort_column == 'normal_schedule_count' %>
                    <i class="bi bi-caret-<%= @sort_direction == 'asc' ? 'up' : 'down' %>-fill"></i>
                  <% end %>
                <% end %>
                <span data-bs-toggle="tooltip" data-bs-placement="top" data-bs-html="true" data-bs-title="Το κανονικό πρόγραμμα για τα δρομολόγια. Αν δεν υπάρχει καμμία έλλειψη σε οχήματα και προσωπικό, αυτά τα δρομολόγια θα πρέπει να γίνουν." class="ms-1" style="cursor: pointer;">
                  <i class="bi bi-question-circle-fill text-white-50" style="font-size: 0.9rem;"></i>
                </span>
              </div>
            </th>
            <th class="align-middle">
              <div class="d-inline-flex align-items-center">
                <%= link_to estimated_coverage_reports_path(sort: 'executed_trips', direction: @sort_column == 'executed_trips' && @sort_direction == 'desc' ? 'asc' : 'desc', date: params[:date]), class: 'text-white text-decoration-none' do %>
                  Εκτιμώμενα δρομολόγια
                  <% if @sort_column == 'executed_trips' %>
                    <i class="bi bi-caret-<%= @sort_direction == 'asc' ? 'up' : 'down' %>-fill"></i>
                  <% end %>
                <% end %>
                <span data-bs-toggle="tooltip" data-bs-placement="top" data-bs-html="true" data-bs-title="Τα εκτιμώμενα δρομολόγια που έγιναν, σύμφωνα με την τηλεματική. Τυπικά είναι ακόμη λιγότερα και από τα δρομολόγια του ημερήσιου προγραμματισμού, λόγω εκτάκτων ελλείψεων σε οχήματα και προσωπικό.<br><br>⚠️ Ο αριθμός είναι κατά προσέγγιση, διάβασε στα Σχετικά." class="ms-1" style="cursor: pointer;">
                  <i class="bi bi-question-circle-fill text-white-50" style="font-size: 0.9rem;"></i>
                </span>
              </div>
            </th>
            <th class="align-middle">
              <div class="d-inline-flex align-items-center">
                <%= link_to estimated_coverage_reports_path(sort: 'coverage', direction: @sort_column == 'coverage' && @sort_direction == 'desc' ? 'asc' : 'desc', date: params[:date]), class: 'text-white text-decoration-none' do %>
                  Εκτιμώμενη κάλυψη
                  <% if @sort_column == 'coverage' %>
                    <i class="bi bi-caret-<%= @sort_direction == 'asc' ? 'up' : 'down' %>-fill"></i>
                  <% end %>
                <% end %>
                <span data-bs-toggle="tooltip" data-bs-placement="top" data-bs-html="true" data-bs-title="Το εκτιμώμενο ποσοστό εκτέλεσης των δρομολογίων<br><br>🟢 Πράσινο: 90-100%<br>🟡 Κίτρινο: 80-89%<br>🔴 Κόκκινο: &lt;80%" class="ms-1" style="cursor: pointer;">
                  <i class="bi bi-question-circle-fill text-white-50" style="font-size: 0.9rem;"></i>
                </span>
              </div>
            </th>
          </tr>
        </thead>
        <tbody>
          <% @results.each do |result| %>
            <tr>
              <td>
                <%= result["line_id"] %> - <%= result["line_description"] %>
              </td>
              <td>
                <%= link_to lines_path(line_code: result["line_code"], route_id: result["route_id"], date: params[:date]), class: 'text-decoration-none' do %>
                  <%= result["route_description"] %>
                <% end %>
              </td>
              <td><%= result["normal_schedule_count"] %></td>
              <td><%= result["executed_trips"] %></td>
              <td>
                <% if result["coverage"].present? %>
                  <% coverage = result["coverage"].to_f.round %>
                  <%
                    # Color gradient logic:
                    # 100% = green (rgb(40, 167, 69))
                    # 90% = yellow (rgb(255, 193, 7))
                    # 80% = orange (rgb(253, 126, 20))
                    # <= 80% = red (rgb(220, 53, 69))

                    if coverage >= 100
                      bg_color = 'rgb(40, 167, 69)'
                      text_color = 'white'
                    elsif coverage >= 90
                      # Gradient between green and yellow
                      ratio = (coverage - 90) / 10.0
                      r = 40 + (255 - 40) * (1 - ratio)
                      g = 167 + (193 - 167) * (1 - ratio)
                      b = 69 + (7 - 69) * (1 - ratio)
                      bg_color = "rgb(#{r.round}, #{g.round}, #{b.round})"
                      text_color = coverage >= 95 ? 'white' : 'black'
                    elsif coverage >= 80
                      # Gradient between yellow and orange
                      ratio = (coverage - 80) / 10.0
                      r = 253 + (255 - 253) * ratio
                      g = 126 + (193 - 126) * ratio
                      b = 20 + (7 - 20) * ratio
                      bg_color = "rgb(#{r.round}, #{g.round}, #{b.round})"
                      text_color = 'black'
                    else
                      # Red for <= 80%
                      bg_color = 'rgb(220, 53, 69)'
                      text_color = 'white'
                    end
                  %>
                  <span class="badge" style="background-color: <%= bg_color %>; color: <%= text_color %>;"><%= coverage %>%</span>
                <% else %>
                  <span class="badge bg-secondary">N/A</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script type="module">
  $(document).ready(function() {
    // Submit form when date changes
    $('#date').on('change', function() {
      $(this).closest('form').submit();
    });
  });
</script>
