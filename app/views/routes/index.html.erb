<h1>Lines</h1>

<%= form_with(url: routes_path, method: :get,
            data: { turbo_frame: "search_results", turbo_action: "advance" }) do |f| %>
    <select id="line_code" name="line_code" >
        <% @lines.each do |line| %>
          <option value="<%= line.code %>"><%= "#{line.line_id}: #{line.description}" %></option>
        <% end %>
    </select>
  <p>
    <input type="date" id="date" name="date" value="<%= params[:date] || Date.current.to_s %>"/>
  </p>

    <div>
      <%= f.submit "Δες τα δρομολόγια" %>
    </div>
<% end %>


<turbo-frame id="search_results">
    <% if @data.present? %>
    <h1><%= @route.description %></h1>

    <div data-routes-data-value="<%= @data.to_json %>" data-all-stops-value="<%= @all_stops.to_json %>" id="myplot" />

    <script type="module">

        import * as Plot from "https://cdn.jsdelivr.net/npm/@observablehq/plot@0.6.17/+esm";
        import * as d3 from "https://cdn.jsdelivr.net/npm/d3@7.9.0/+esm"

        const div = document.querySelector("#myplot");
        const arrivals = JSON.parse(div.getAttribute('data-routes-data-value'))
        const allStops = JSON.parse(div.getAttribute('data-all-stops-value'))
        console.log(arrivals)

        function asTime(minutes) {
            return formatTime(d3.utcMinute.offset(d3.utcDay(), minutes - minutesOffset));
        }

        const minutesOffset = -60 * 2 // no trains run at 2 AM
        const parseTime = d3.utcParse("%I:%M%p")
        const formatTime = d3.utcFormat("%-I %p")
        const schedule = "weekday"

        function asMinutes(time) {
            if (!(time = parseTime(time))) return;
            const minutes = time.getUTCHours() * 60 + time.getUTCMinutes();
            return (minutes + minutesOffset + 60 * 24) % (24 * 60);
        }

        const plot = Plot.plot({
            inset: 10,
            margin: 10,
            marginLeft: 40,
            marginTop: 100,
            grid: true,
            width: 1152,
            height: 1800,
            x: {
                axis: null // hide arbitrary distance units
            },
            y: {
                label: null,
                ticks: d3.range(3, 24).map(h => h * 60),
                tickFormat: asTime,
                transform: asMinutes,
                reverse: true
            },
            color: {
                legend: true,
                domain: ["normal", "limited", "bullet"],
                range: ["rgb(34, 34, 34)", "rgb(183, 116, 9)", "rgb(192, 62, 29)"]
            },
            marks: [
                Plot.ruleX(allStops, {x: "position", strokeOpacity: 0.1, strokeDasharray: 2}),
                Plot.text(allStops, {x: "position", text: "name", y: () => "4:30am", rotate: -90, frameAnchor: "left", dy: -12}),
                Plot.line(arrivals, {filter: d => d.schedule === schedule, x: "distance", y: "time", z: "vehicle", stroke: "speed", marker: "circle", title: (d) => `${d.vehicle}${d.direction}\n${d.stop}\n${d.time}`, tip: true})
            ]
        });

        div.append(plot);
    </script>
    <% end %>
</turbo-frame>



<script type="module">
    $(document).ready(function() {

        $('#line_code').select2();
    });
</script>

