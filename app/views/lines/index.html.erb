<% if(@line.present?) %>
  <% content_for :title, "Athens Bus - #{@line.line_id}" %>
<% end %>

<%= form_with(url: lines_path, method: :get, data: { turbo_frame: "search_results", turbo_action: "advance" }) do |f| %>
  <div>
    <div class="form-group mb-3">
      <label for="line_code">Γραμμή</label>
      <select id="line_code" name="line_code" class="form-select">
        <option value="" selected="<%= @line.blank? %>" disabled="true"></option>
        <% @lines.each do |line| %>
        <option value="<%= line.code %>"<%= line.code == params[:line_code] ? ' selected="true"'.html_safe : '' %>>
            <%= "#{line.line_id}: #{line.description}" %>
        </option>
        <% end %>
      </select>
      <small class="form-text text-muted">Διάλεξε μια γραμμή λεωφορείου από τη λίστα</small>
    </div>

    <%= render 'route_select' %>

    <div class="form-group mb-3">
      <label for="date">Ημερομηνία</label>
      <input type="date" id="date" name="date"
             class="form-control" style="width: 170px;"
             min="<%= @date_min %>"
             max="<%= @date_max %>"
             value="<%= params[:date] || Date.current.to_s %>"
        />
      <small class="form-text text-muted">Διάλεξε την ημερομηνία</small>
    </div>

  </div>

<% end %>


<% if(@line.present?) %>
  <h1>
    <% if(@line.line_id == "140") %>
      <%= link_to "140", "https://www.youtube.com/watch?v=s4UwlLzHn5A" %>: <%= @route.description %>
    <% else %>
      <%= "#{@line.line_id}: #{@route.description}" %>
    <% end %>
  </h1>
  <%= link_to "History", route_history_url(@route.route_id) %>
  <%= render 'itinerary' %>
  <%= render 'search_results' %>
<% end %>

<script type="module">
    $(document).ready(function() {
        $('#line').select2({
            theme: 'bootstrap-5',
            containerCssClass: 'form-select-lg',
            closeOnSelect: true,
            dropdownAutoWidth: true
        });

        // Clear route selection when line changes
        $('#line_code').on('change', function() {
            $('#route_id').val('');
            $(this).closest('form').submit();
        });

        // Submit form when route changes
        $('#route_id').on('change', function() {
            $(this).closest('form').submit();
        });

        // Submit form when date changes
        $('#date').on('change', function() {
            $(this).closest('form').submit();
        });

        // Ensure clicking outside closes the dropdown
        $(document).on('click', function(e) {
            if (!$(e.target).closest('.select2').length) {
                $('#line').select2('close');
            }
        });
    });
</script>
