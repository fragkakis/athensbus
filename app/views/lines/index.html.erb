<% if(@line.present?) %>
  <% content_for :title, "Athens Bus - #{@line.line_id}" %>
<% end %>

<div class="py-4">

      <!-- Search Card -->
      <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px;">
        <div class="card-body p-4">
          <h5 class="card-title mb-4 text-primary fw-bold">
            <i class="bi bi-search me-2"></i>Αναζήτηση Δρομολογίου
          </h5>

          <%= form_with(url: lines_path, method: :get) do |f| %>
            <div class="row g-3">

              <div class="col-12">
                <label for="line_code" class="form-label fw-semibold">
                  <i class="bi bi-bus-front me-1"></i>Γραμμή
                </label>
                <select id="line_code" name="line_code" class="form-select form-select-lg">
                  <option value="" selected="<%= @line.blank? %>" disabled="true">Επιλέξτε γραμμή...</option>
                  <% @lines.each do |line| %>
                  <option value="<%= line.code %>"<%= line.code == params[:line_code] ? ' selected="true"'.html_safe : '' %>>
                      <%= "#{line.line_id}: #{line.description}" %>
                  </option>
                  <% end %>
                </select>
                <div class="form-text">
                  <i class="bi bi-info-circle me-1"></i>Διάλεξε μια γραμμή λεωφορείου από τη λίστα
                </div>
              </div>

              <div class="col-12">
                <%= render 'route_select' %>
              </div>

              <div class="col-12 col-md-6">
                <label for="date" class="form-label fw-semibold">
                  <i class="bi bi-calendar-event me-1"></i>Ημερομηνία
                </label>
                <input type="date" id="date" name="date"
                       class="form-control form-control-lg"
                       min="<%= @date_min %>"
                       max="<%= @date_max %>"
                       value="<%= params[:date] || Date.current.to_s %>"
                  />
                <div class="form-text">
                  <i class="bi bi-info-circle me-1"></i>Διάλεξε την ημερομηνία
                </div>
              </div>

            </div>
          <% end %>
        </div>
      </div>


<% if(@line.present?) %>
      <!-- Line Header -->
      <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
        <div class="card-body p-3 p-md-4 text-white">
          <h2 class="mb-0 fw-bold fs-4 fs-md-3">
            <%= image_tag 'icon.png', alt: 'Bus', style: 'height: 1.6em; vertical-align: middle; filter: brightness(0) invert(1);' %>
            <% if(@line.line_id == "140") %>
              <%= link_to "https://www.youtube.com/watch?v=s4UwlLzHn5A", class: "text-white text-decoration-none", title: "Κάνε κλικ για μία έκπληξη", style: "position: relative;" do %>
                <span style="text-decoration: underline; text-decoration-style: dotted;">140</span>
                <span style="font-size: 0.9em; margin-left: 6px; animation: pulse 2s infinite;">🥚</span>
              <% end %>: <%= @route.description %>
            <% else %>
              <%= "#{@line.line_id}: #{@route.description}" %>
            <% end %>
          </h2>
        </div>
      </div>

      <%= render 'itinerary' %>
      <%= render 'search_results' %>
<% end %>

</div>

<style>
    @keyframes pulse {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.6; transform: scale(1.1); }
    }
</style>

<script type="module">
    $(document).ready(function() {
        // Clear route selection when line changes
        $('#line_code').on('change', function() {
            $('#route_id').val('');
            $(this).closest('form').submit();
        });

        // Submit form when route changes
        $('#route_id').on('change', function() {
            $(this).closest('form').submit();
        });

        // Submit form when date changes
        $('#date').on('change', function() {
            $(this).closest('form').submit();
        });
    });
</script>
