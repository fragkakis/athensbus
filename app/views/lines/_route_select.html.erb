<turbo-frame id="route_select">
  <div class="form-group mb-3">
    <select id="route_id" name="route_id" class="form-select" <%= (@line.blank? || @line.routes.count < 2) ? 'disabled="true" : '' %>">
      <% @line&.routes&.each do |route| %>
        <option value="<%= route.route_id %>" <%= route.route_id == @route&.id ? 'selected="true"' : '' %>>
          <%= route.description %>
        </option>
      <% end %>
    </select>
    <small class="form-text text-muted">Διάλεξε μια διαδρομή από τη λίστα</small>
  </div>
</turbo-frame>