<%= form_with(url: lines_path, method: :get, data: { turbo_frame: "search_results", turbo_action: "advance" }) do |f| %>
  <div>
    <div class="form-group mb-3">
      <label for="line">Γραμμή</label>
      <select id="line_id" name="line_id" class="form-select">
        <option value="" selected="<%= @line.blank? %>" disabled="true"></option>
        <% @lines.each do |line| %>
        <option value="<%= line.line_id %>"<%= line.line_id == params[:line_id] ? ' selected="true"' : '' %>>
            <%= "#{line.line_id}: #{line.description}" %>
        </option>
        <% end %>
      </select>
      <small class="form-text text-muted">Διάλεξε μια γραμμή λεωφορείου από τη λίστα</small>
    </div>

    <%= render 'route_select' %>

    <div class="form-group mb-3">
      <label for="date">Ημερομηνία</label>
      <input type="date" id="date" name="date" class="form-control" style="width: 170px;" value="<%= params[:date] || Date.current.to_s %>"/>
      <small class="form-text text-muted">Διάλεξε την ημερομηνία</small>
    </div>

  </div>

<% end %>

<%= render 'search_results' %>

<script type="module">
    $(document).ready(function() {
        $('#line').select2({
            theme: 'bootstrap-5',
            containerCssClass: 'form-select-lg',
            closeOnSelect: true,
            dropdownAutoWidth: true
        });

        // Clear route selection when line changes
        $('#line_id').on('change', function() {
            $(this).closest('form').submit();
        });

        // Submit form when route changes
        $('#route_id').on('change', function() {
            $(this).closest('form').submit();
        });

        // Submit form when date changes
        $('#date').on('change', function() {
            $(this).closest('form').submit();
        });

        // Ensure clicking outside closes the dropdown
        $(document).on('click', function(e) {
            if (!$(e.target).closest('.select2').length) {
                $('#line').select2('close');
            }
        });
    });
</script>
