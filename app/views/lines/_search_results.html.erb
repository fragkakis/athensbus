<div>
  <% if @data.present? %>

      <div class="card border-0 shadow-sm mt-4" style="border-radius: 12px;">
        <div class="card-body p-4">
          <h3 class="card-title mb-4 fw-bold text-secondary">
            <i class="bi bi-graph-up me-2"></i>Τηλεματική
          </h3>

          <div id="myplot" class="overflow-auto"></div>

      <script type="module">
          import * as Plot from "https://cdn.jsdelivr.net/npm/@observablehq/plot@0.6.17/+esm";
          import * as d3 from "https://cdn.jsdelivr.net/npm/d3@7.9.0/+esm"

          const div = document.querySelector("#myplot");
          const arrivals = <%= raw @data.to_json %>
          const allStops = <%= raw @all_stops.to_json %>

          function asTime(minutes) {
              return formatTime(d3.utcMinute.offset(d3.utcDay(), minutes - minutesOffset));
          }

          function asTimeForLabels(minutes) {
              const formatTimeForLabels = d3.utcFormat("%I:%M%p");
              return formatTimeForLabels(d3.utcMinute.offset(d3.utcDay(), minutes - minutesOffset)).toLowerCase();
          }

          const minutesOffset = -60 * 2 // no trains run at 2 AM
          const parseTime = d3.utcParse("%I:%M%p")
          const formatTime = d3.utcFormat("%-I %p")
          const schedule = "weekday"
          const distinctVehicles = [...new Set(arrivals.map(a => a.vehicle))].sort();
          const colors = ["red", "green", "blue", "orange", "brown", "black", "maroon", "purple", "olive", "teal", "indigo"]

          // Find earliest arrival time
          const earliestArrival = arrivals.length > 0 ?
              d3.min(arrivals, d => asMinutes(d.time)) :
              3 * 60 // fallback to 3am if no arrivals

          // Calculate midnight in the offset coordinate system
          const midnightInOffset = asMinutes("12:00am")

          function asMinutes(time) {
              if (!(time = parseTime(time))) return;
              const minutes = time.getUTCHours() * 60 + time.getUTCMinutes();
              return (minutes + minutesOffset + 60 * 24) % (24 * 60);
          }

          const plot = Plot.plot({
              inset: 10,
              margin: 10,
              marginLeft: 40,
              marginTop: 100,
              grid: true,
              width: 1152,
              height: 1800,
              x: {
                  axis: null // hide arbitrary distance units
              },
              y: {
                  label: null,
                  domain: [earliestArrival, midnightInOffset], // from earliest arrival to midnight
                  ticks: d3.range(Math.floor(earliestArrival / 60), 25).map(h => h * 60),
                  tickFormat: asTime,
                  transform: asMinutes,
                  reverse: true
              },
              marks: [
                  Plot.ruleX(allStops, {x: "position", strokeOpacity: 0.1, strokeDasharray: 2}),
                  Plot.text(allStops, {x: "position", text: "name", y: () => asTimeForLabels(earliestArrival), rotate: -90, frameAnchor: "left", dy: -12}),
                  Plot.line(arrivals, {
                      x: "distance",
                      y: "time",
                      z: "vehicle",
                      stroke: (d) => colors[distinctVehicles.indexOf(d.vehicle) % (colors.length - 1)],
                      marker: "circle",
                      title: (d) => `${d.time}\n${d.stop}\n${d.vehicle}`,
                      tip: true
                  })
              ]
          });

          div.append(plot);
      </script>

        </div>
      </div>

    <% elsif @line.present? %>
      <div class="card border-0 shadow-sm mt-4" style="border-radius: 12px;">
        <div class="card-body p-5 text-center">
          <div class="mb-4">
            <i class="bi bi-exclamation-circle text-warning" style="font-size: 4rem;"></i>
          </div>
          <h3 class="fw-bold mb-3">Δεν βρέθηκαν δεδομένα</h3>
          <p class="text-muted mb-4">Δεν υπάρχουν διαθέσιμα δεδομένα τηλεματικής για την επιλεγμένη ημερομηνία</p>

        </div>
      </div>
    <% end %>
</div>